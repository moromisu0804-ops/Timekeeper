rules_version = '2';

// このアプリのデータは users/{ログインユーザーのUID}/... という階層にのみ保存されます。
// アクセスを許可するのは、あなた自身のFirebase AuthenticationのUID
// (Firebaseコンソール > Authentication > Users タブの「User UID」列)を
// 持つアカウントでログインした場合のみです。
//
// メールアドレスのような個人情報は使わず、意味を持たないランダムな
// 識別子(UID)だけでアクセス制限しているため、このファイルが公開されても
// 個人情報が漏れることはありません。
//
// 【UIDを変更・追加したい場合】
// 下の allowedUid() 関数の中の文字列を書き換えてください。
service cloud.firestore {
  match /databases/{database}/documents {
    function allowedUid() {
      return "6S5vuQbar8hJkbUQN4tyyrzCHEf2";
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.uid == allowedUid();
    }
  }
}
